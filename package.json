{
  "name": "pi-loops",
  "version": "0.16.0",
  "description": "An automation layer for pi: cron + stateful loops with a triage inbox, maker/checker verification, dynamic triggers, MCP notifications and tools, lifecycle hooks, session archives. A non-invasive pi extension.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphacoder-v0/pi-loops.git"
  },
  "homepage": "https://github.com/alphacoder-v0/pi-loops#readme",
  "bugs": {
    "url": "https://github.com/alphacoder-v0/pi-loops/issues"
  },
  "keywords": [
    "pi",
    "coding-agent",
    "pi-package",
    "pi-extension",
    "cron",
    "loops",
    "inbox",
    "triggers",
    "mcp",
    "hooks"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "src",
    "skills",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "ci": "npm run typecheck && npm run lint && npm run check:scripts && npm test",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --import ./src/register-pi.mjs --test test/*.test.ts",
    "check:scripts": "node --check src/web.mjs && node --check src/cli-entry.mjs && node --check src/register-pi.mjs && node --check examples/mcp-notify-server.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/alphacoder-v0/pi-loops/main/docs/screenshot.png",
    "extensions": [
      "./src/pi-loops.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "pi-loops": "./src/cli-entry.mjs"
  }
}
